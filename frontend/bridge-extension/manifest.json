{
  "manifest_version": 3,
  "name": "TalentMind Manual Capture",
  "version": "1.0.0",
  "description": "Only reads the visible BOSS page after an explicit user click.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:18000/*"
  ],
  "action": {
    "default_title": "TalentMind 手动采集",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
