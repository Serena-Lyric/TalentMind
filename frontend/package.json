{
    "name": "job-skill-graph",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "packageManager": "pnpm@11.5.1",
    "engines": {
        "node": ">=24.15.0 <25"
    },
    "scripts": {
        "dev": "vite",
        "test": "node --experimental-strip-types --test tests/*.test.ts",
        "typecheck": "vue-tsc --noEmit",
        "build": "pnpm run typecheck && vite build",
        "preview": "vite preview",
        "build:open": "pnpm run build && pnpm run preview --open --port 4173",
        "start": "pnpm run build:open",
        "serve": "pnpm run preview --host 127.0.0.1 --port 4173"
    },
    "dependencies": {
        "@element-plus/icons-vue": "^2.3.1",
        "axios": "^1.6.0",
        "camera-controls": "3.1.2",
        "element-plus": "^2.9.4",
        "html2canvas": "^1.4.1",
        "jspdf": "^2.5.1",
        "pinia": "^2.1.7",
        "three": "0.180.0",
        "vue": "^3.5.13",
        "vue-router": "^4.2.5"
    },
    "devDependencies": {
        "@types/three": "0.180.0",
        "@vitejs/plugin-vue": "^5.2.1",
        "typescript": "~5.3.3",
        "vite": "^4.5.0",
        "vue-tsc": "^1.8.25"
    }
}
