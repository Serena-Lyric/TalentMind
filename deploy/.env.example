TALENTMIND_VERSION=dev
TALENTMIND_DATA_DIR=/opt/talentmind/data
TALENTMIND_ENV_FILE=.env
TALENTMIND_HTTP_PORT=80
TALENTMIND_HTTPS_PORT=443
TALENTMIND_SERVER_NAME=_
TALENTMIND_TLS_MODE=selfsigned
TALENTMIND_REGISTRY_MIRROR=https://mirror.ccs.tencentyun.com
TALENTMIND_ADMIN_USER=admin
TALENTMIND_ADMIN_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
TALENTMIND_TRUSTED_PROXY_SECRET=
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
TALENTMIND_M2_CONFIG=/app/deploy/m2/config.json
TALENTMIND_M2_KEY_FILE=/app/deploy/m2/api-key.txt
