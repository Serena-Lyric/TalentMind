# Deployment archives are built with `git archive`; Windows core.autocrlf=true
# would otherwise turn text files into CRLF and break Bash on Ubuntu.
deploy/** text eol=lf
scripts/*.sh text eol=lf
# B3-5 definition provenance hashes must survive checkout on every platform.
docs/PRODUCT_DECISIONS.md text eol=lf
# Immutable knowledge and policy bytes are verified against committed SHA-256 manifests.
backend/app/job_analysis/knowledge/catalog/** text eol=lf
backend/app/job_analysis/knowledge/policies/** text eol=lf
